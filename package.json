{
  "name": "agentglass-streamdeck",
  "version": "0.2.0",
  "description": "OpenDeck / Stream Deck + plugin to drive the agentglass cockpit — switch views, approve tool calls, watch the fleet.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/make-icons.mjs && rollup -c && chmod +x com.agentglass.controller.sdPlugin/bin/plugin.js",
    "icons": "node scripts/make-icons.mjs",
    "watch": "rollup -c -w",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.7.0",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  }
}
