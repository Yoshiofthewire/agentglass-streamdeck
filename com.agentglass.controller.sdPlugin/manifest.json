      "UUID": "com.agentglass.controller.view.git",
      "Icon": "imgs/actions/view.git/icon",
      "Tooltip": "Open the git view — status, branches, commits.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/actions/view.git/icon",
          "TitleAlignment": "middle",
          "Title": ""
        }
      ]
