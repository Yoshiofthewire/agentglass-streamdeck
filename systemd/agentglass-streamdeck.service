# Run the daemon at login as a user service (no root):
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/agentglass-streamdeck.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentglass-streamdeck
#
# Adjust ExecStart if you installed into a venv rather than with pipx / --user.
[Unit]
Description=agentglass Stream Deck + controller
Documentation=https://github.com/Yoshiofthewire/agentglass-streamdeck
# Wait for a graphical session so the notification/theme surface is up.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/agentglass-streamdeck
# The deck comes and goes with USB; keep trying rather than giving up.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
